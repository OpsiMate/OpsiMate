      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 35,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Ingestion by integration type",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
