        {
          "expr": "sum(rate(opsimate_snapshot_compute_duration_seconds_count[5m])) by (list)",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "legendFormat": "recomputes/s {{list}}"
