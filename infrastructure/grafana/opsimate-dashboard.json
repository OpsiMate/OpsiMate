    {
      "type": "timeseries",
      "title": "Alert lifecycle",
      "description": "How alerts leave the firing state: manual resolves are people, auto resolves are sources reporting recovery. Silence/unsilence includes timer expiry and the daily reset.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
