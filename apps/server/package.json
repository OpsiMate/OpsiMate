{
	"name": "@OpsiMate/server",
	"version": "1.0.0",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"start": "node dist/index.js",
		"start:worker": "node dist/worker.js",
		"debug": "node --inspect=0.0.0.0:9229 dist/index.js",
		"debug:worker": "node --inspect=0.0.0.0:9230 dist/worker.js",
		"build": "vite build --config vite.config.prod.ts",
		"build-dev": "vite build --mode development",
		"dev": "vite",
		"dev:worker": "tsx watch src/worker.ts",
		"clean": "rm -rf dist",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint src --ext .ts",
		"lint-fix": "eslint src --ext .ts --fix",
		"format": "prettier --check .",
		"format-fix": "prettier --write .",
		"check": "pnpm run format && pnpm run lint",
		"fix": "pnpm run format-fix && pnpm run lint-fix"
	},
	"dependencies": {
		"@OpsiMate/custom-actions": "workspace:*",
		"@OpsiMate/shared": "workspace:*",
		"@types/cors": "^2.8.19",
		"@types/jsonwebtoken": "^9.0.10",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^13.0.3",
		"compression": "^1.8.1",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"js-yaml": "^5.3.0",
		"jsonwebtoken": "^9.0.3",
		"multer": "^2.2.0",
		"node-ssh": "^13.2.1",
		"nodemailer": "^9.0.5",
		"prom-client": "^15.1.3",
		"sshpk": "^1.18.0",
		"vite": "^8.2.2",
		"vite-plugin-node": "^8.0.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/compression": "^1.8.1",
		"@types/js-yaml": "^4.0.9",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.2.0",
		"@types/nodemailer": "^8.0.1",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.8.1",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	}
}
